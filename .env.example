# Server-side only (used by api/sheets.ts, never sent to the browser)
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
API_KEY=your-secret-key-here

# Client-side (Vite bundles VITE_* into the browser build — no secrets here)
VITE_API_KEY=your-secret-key-here
VITE_DEMO_MODE=false

# Optional: use a Google Apps Script Web App instead of the /api/sheets serverless function
# VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_ID/exec
